# Copy to .env for local development. Never commit the real .env.

# --- database (defaults match docker-compose) --------------------------------
DATABASE_URL=jdbc:postgresql://localhost:5432/store
DATABASE_USERNAME=store
DATABASE_PASSWORD=store

# --- security ----------------------------------------------------------------
# At least 32 characters. Generate one: openssl rand -base64 48
JWT_SECRET=

# --- stripe (test mode) -------------------------------------------------------
# Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen --forward-to localhost:8080/checkout/webhook`
STRIPE_WEBHOOK_SECRET_KEY=whsec_...

# --- frontend -----------------------------------------------------------------
WEBSITE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
